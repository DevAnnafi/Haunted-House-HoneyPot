# Copy to .env (gitignored) and fill in. Never commit .env.
# Used by docker-compose.yml (honeypot service, via env_file) and by local runs.
#
# NOTE: the names below marked "T1.10" are the planned config-loader variables.
# Reconcile them with honeypot/__main__.py once T1.10 lands.

# --- Secrets -----------------------------------------------------------------
# HMAC key for password fingerprints (ADR-0002). 64 hex chars recommended.
HONEYPOT_HMAC_SECRET=generate-with: python -c "import secrets; print(secrets.token_hex(32))"

# Judge/demo login (ADR-0006). Must be non-guessable. Share only via the private Devpost form.
HONEYPOT_DEMO_USERNAME=change-me
HONEYPOT_DEMO_PASSWORD=change-me

# PostgreSQL connection as the honeypot_writer role (ADR-0004). The host "postgres" is the
# compose service name. The password must match honeypot_writer_password used when
# migrations/001_initial.sql was applied. Special characters must be URL-encoded.
HONEYPOT_DATABASE_URL=postgresql://honeypot_writer:change-me@postgres:5432/honeypot

# Anthropic API key for the LLM fallback. Leave empty only if the loader allows it.
HONEYPOT_LLM_API_KEY=

# --- Host key (T1.10) ----------------------------------------------------------
# Host path of the SSH private host key. Keep it OUTSIDE the repo. Compose mounts it
# read-only at /run/secrets/ssh_host_key inside the container. Used by compose only.
# The container runs as UID/GID 10001, so on the host:
#   chown 10001:10001 /etc/honeypot/ssh_host_key && chmod 0400 /etc/honeypot/ssh_host_key
# Generate with: ssh-keygen -t ed25519 -N "" -f /etc/honeypot/ssh_host_key
HONEYPOT_HOST_KEY_FILE=/etc/honeypot/ssh_host_key

# --- Timeouts, in seconds (T1.10) ---------------------------------------------
# Set in compose, not here: HONEYPOT_SSH_PORT (2222) and HONEYPOT_HOST_KEY_PATH.
HONEYPOT_IDLE_TIMEOUT=300
HONEYPOT_LIFETIME_LIMIT=1800
HONEYPOT_SETUP_TIMEOUT=30
