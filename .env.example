# Copy to .env (gitignored) and fill in. Never commit .env.
# Used by docker-compose.yml (honeypot service, via env_file) and by local runs
# (`python -m honeypot` loads .env). Variable names match honeypot/config.py and
# honeypot/auth.py. Add more here only when the code reads them.

# --- Secrets (honeypot/auth.py; all three are required) ----------------------
# HMAC key for password fingerprints (ADR-0002). 64 hex chars recommended.
HONEYPOT_HMAC_SECRET=generate-with: python -c "import secrets; print(secrets.token_hex(32))"

# Judge/demo login (ADR-0006). Must be non-guessable. Share only via the private Devpost form.
HONEYPOT_DEMO_USERNAME=change-me
HONEYPOT_DEMO_PASSWORD=change-me

# --- Listener (honeypot/config.py) -------------------------------------------
# Address to bind. Default 127.0.0.1 (local only). docker-compose.yml overrides this
# to 0.0.0.0 inside the container, so leave it at the default for Docker.
HONEYPOT_SSH_HOST=127.0.0.1

# TCP port to bind, 1-65535. Default 2222. docker-compose.yml fixes it to 2222.
# HONEYPOT_SSH_PORT=2222

# Path to the SSH private host key (required for local runs). docker-compose.yml
# overrides this with the in-container path /run/secrets/ssh_host_key.
# Generate with: ssh-keygen -t ed25519 -N "" -f /etc/honeypot/ssh_host_key
HONEYPOT_HOST_KEY_PATH=/etc/honeypot/ssh_host_key

# Seconds an unauthenticated connection may stay open. Positive number, default 15.0.
# HONEYPOT_SETUP_TIMEOUT=15.0

# Seconds without client activity before a session is closed (end_reason idle). Positive
# number, default 300. Input, terminal resizes and Ctrl+C count as activity.
# HONEYPOT_IDLE_TIMEOUT=300
# Maximum seconds a session may last, counted from acceptance (end_reason lifetime).
# Positive number, default 1800. Activity does not extend it.
# HONEYPOT_SESSION_LIFETIME=1800
# Weak-credential list. Default config/credentials.toml (relative to the working directory).
# HONEYPOT_CREDENTIALS_PATH=config/credentials.toml

# --- Database -----------------------------------------------------------------
# Connection URL for the honeypot's database role (ADR-0004). Required. The user is
# honeypot_writer, the host is the postgres service on db_net, and the password is the
# honeypot_writer password from db-roles.env. Use only URL-safe characters in it
# (docs/deployment.md generates one with openssl rand -hex).
HONEYPOT_DATABASE_URL=postgresql://honeypot_writer:change-me@postgres:5432/honeypot

# --- Docker Compose only (not read by the honeypot) ---------------------------
# Host path of the host key, mounted read-only into the container. Keep it OUTSIDE the
# repo. The container runs as UID/GID 10001, so on the host:
#   chown 10001:10001 /etc/honeypot/ssh_host_key && chmod 0400 /etc/honeypot/ssh_host_key
HONEYPOT_HOST_KEY_FILE=/etc/honeypot/ssh_host_key
