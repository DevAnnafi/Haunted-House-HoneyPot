# Copy to postgres.env (gitignored via *.env) and fill in. Never commit postgres.env.
# Read only by the postgres service. Kept separate from .env so the honeypot container
# never receives the superuser password (ADR-0003).

# Superuser password. Used to apply migrations/001_initial.sql; the honeypot itself
# connects as honeypot_writer, never as this user.
POSTGRES_PASSWORD=generate-with: python -c "import secrets; print(secrets.token_urlsafe(32))"
