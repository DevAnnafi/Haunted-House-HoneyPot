# Copy to db-roles.env (gitignored via *.env), owned by root, mode 600. Never commit it.
# Read only by scripts/init-db.sh, which runs as root. No container reads this file: it is
# not an env_file, so the honeypot never receives the dashboard passwords (ADR-0003).
# One NAME=value per line, no quotes. Each value: at least 16 characters from
# A-Z a-z 0-9 . _ ~ - (safe in a URL).
# docs/deployment.md generates all three with: openssl rand -hex 24
# The honeypot_writer value must match the password inside HONEYPOT_DATABASE_URL in .env.
HONEYPOT_WRITER_PASSWORD=generate-with: openssl rand -hex 24
DASHBOARD_ADMIN_PASSWORD=generate-with: openssl rand -hex 24
DASHBOARD_JUDGE_PASSWORD=generate-with: openssl rand -hex 24
